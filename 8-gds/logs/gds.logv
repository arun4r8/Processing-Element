[11/11 11:28:37     18s] @file 24: # Scores the finished design with ppa.tcl: setup timing at tt from 6-sta, power from 7-emir,
[11/11 11:28:37     18s] @file 25: # and the area of the logic cells (fillers, taps and end caps left out).
[11/11 11:28:37     18s] @file 26: # ppa_report reads Genus report text, so the numbers are first written in that format.
[11/11 11:28:37     18s] @file 27:
[11/11 11:28:37     18s] @file 28: # Worst setup slack in ns: the first path in 6-sta's setup report
[11/11 11:28:37     18s] @file 29: set fh [open $sta_rpt/setup.rpt]
[11/11 11:28:37     18s] @file 30: set setup [read $fh]
[11/11 11:28:37     18s] @file 31: close $fh
[11/11 11:28:37     18s] @file 32: regexp {Path 1: \S+ \((-?[0-9.]+) ns\)} $setup -> wns
[11/11 11:28:37     18s] @file 33:
[11/11 11:28:37     18s] @file 34: # TNS in ns and failing paths: the Standard group of the tt setup section in the summary.
[11/11 11:28:37     18s] @file 35: # The summary only lists failing paths, so when setup passes there is no line and both stay 0.
[11/11 11:28:37     18s] @file 36: # The Async group (reset recovery and removal) is left out, as in synthesis.
[11/11 11:28:37     18s] @file 37: set fh [open $sta_rpt/summary.rpt]
[11/11 11:28:37     18s] @file 38: set sta [read $fh]
[11/11 11:28:37     18s] @file 39: close $fh
[11/11 11:28:37     18s] @file 40: set tns  0
[11/11 11:28:37     18s] @file 41: set nvio 0
[11/11 11:28:37     18s] @file 42: regexp {View:view_tt\) \(EL:Setup\).*?GroupType:Standard.*?\n\s*(-?[0-9.]+):(-?[0-9.]+):([0-9]+)\s} $sta -> sum_wns tns nvio
[11/11 11:28:37     18s] @file 43:
[11/11 11:28:37     18s] @file 44: # Power in mW
[11/11 11:28:37     18s] @file 45: set fh [open $emir_rpt/power/power.rpt]
[11/11 11:28:37     18s] @file 46: set pwr [read $fh]
[11/11 11:28:37     18s] @file 47: close $fh
[11/11 11:28:37     18s] @file 48: regexp {Total Internal Power:\s+(\S+)}  $pwr -> int_mw
[11/11 11:28:37     18s] @file 49: regexp {Total Switching Power:\s+(\S+)} $pwr -> sw_mw
[11/11 11:28:37     18s] @file 50: regexp {Total Leakage Power:\s+(\S+)}   $pwr -> leak_mw
[11/11 11:28:37     18s] @file 51: regexp {Total Power:\s+(\S+)}           $pwr -> tot_mw
[11/11 11:28:37     18s] @file 52:
[11/11 11:28:37     18s] @file 53: set area 0
[11/11 11:28:37     18s] @file 54: foreach inst [get_db insts] {
[11/11 11:28:37     18s]     if {![regexp {__(fill|decap|tapvpwrvgnd)_} [get_db $inst .base_cell.name]]} {
[11/11 11:28:37     18s]         set area [expr {$area + [get_db $inst .area]}]
[11/11 11:28:37     18s]     }
[11/11 11:28:37     18s] }
[11/11 11:28:37     19s] Multithreaded Timing Analysis is initialized with 2 threads
[11/11 11:28:37     19s] 
[11/11 11:28:37     19s] @file 59: set period_ps [expr {[lindex [get_db clocks .period] 0] * 1000}]
[11/11 11:28:37     19s] @file 60:
[11/11 11:28:37     19s] @file 61: set fh [open $rpt_dir/final_qor.rpt w]
[11/11 11:28:37     19s] @file 62: puts $fh "Clock Period\n------------\nclk $period_ps\n"
[11/11 11:28:37     19s] @file 63: puts $fh "clk [expr {$wns * 1000}] [expr {$tns * 1000}] $nvio"
[11/11 11:28:37     19s] @file 64: puts $fh "Total Cell Area (Cell+Physical) $area"
[11/11 11:28:37     19s] @file 65: close $fh
[11/11 11:28:37     19s] @file 66:
[11/11 11:28:37     19s] @file 67: set fh [open $rpt_dir/final_power.rpt w]
[11/11 11:28:37     19s] @file 68: puts $fh "Subtotal [expr {$leak_mw / 1000.0}] [expr {$int_mw / 1000.0}] [expr {$sw_mw / 1000.0}] [expr {$tot_mw / 1000.0}]"
[11/11 11:28:37     19s] @file 69: close $fh
[11/11 11:28:37     19s] @file 70:
