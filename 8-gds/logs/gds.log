@file 22:
@file 23: # ââ Final PPA ââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
@file 24: # Scores the finished design with ppa.tcl: setup timing at tt from 6-sta, power from 7-emir,
@file 25: # and the area of the logic cells (fillers, taps and end caps left out).
@file 26: # ppa_report reads Genus report text, so the numbers are first written in that format.
@file 27:
@file 28: # Worst setup slack in ns: the first path in 6-sta's setup report
@file 29: set fh [open $sta_rpt/setup.rpt]
@file 30: set setup [read $fh]
@file 31: close $fh
@file 32: regexp {Path 1: \S+ \((-?[0-9.]+) ns\)} $setup -> wns
@file 33:
@file 34: # TNS in ns and failing paths: the Standard group of the tt setup section in the summary.
@file 35: # The summary only lists failing paths, so when setup passes there is no line and both stay 0.
@file 36: # The Async group (reset recovery and removal) is left out, as in synthesis.
@file 37: set fh [open $sta_rpt/summary.rpt]
@file 38: set sta [read $fh]
@file 39: close $fh
@file 40: set tns  0
@file 41: set nvio 0
@file 42: regexp {View:view_tt\) \(EL:Setup\).*?GroupType:Standard.*?\n\s*(-?[0-9.]+):(-?[0-9.]+):([0-9]+)\s} $sta -> sum_wns tns nvio
@file 43:
@file 44: # Power in mW
@file 45: set fh [open $emir_rpt/power/power.rpt]
@file 46: set pwr [read $fh]
@file 47: close $fh
@file 48: regexp {Total Internal Power:\s+(\S+)}  $pwr -> int_mw
@file 49: regexp {Total Switching Power:\s+(\S+)} $pwr -> sw_mw
@file 50: regexp {Total Leakage Power:\s+(\S+)}   $pwr -> leak_mw
@file 51: regexp {Total Power:\s+(\S+)}           $pwr -> tot_mw
@file 52:
@file 53: set area 0
@file 54: foreach inst [get_db insts] {
    if {![regexp {__(fill|decap|tapvpwrvgnd)_} [get_db $inst .base_cell.name]]} {
        set area [expr {$area + [get_db $inst .area]}]
    }
}
Multithreaded Timing Analysis is initialized with 2 threads

@file 59: set period_ps [expr {[lindex [get_db clocks .period] 0] * 1000}]
@file 60:
@file 61: set fh [open $rpt_dir/final_qor.rpt w]
@file 62: puts $fh "Clock Period\n------------\nclk $period_ps\n"
@file 63: puts $fh "clk [expr {$wns * 1000}] [expr {$tns * 1000}] $nvio"
@file 64: puts $fh "Total Cell Area (Cell+Physical) $area"
@file 65: close $fh
@file 66:
@file 67: set fh [open $rpt_dir/final_power.rpt w]
@file 68: puts $fh "Subtotal [expr {$leak_mw / 1000.0}] [expr {$int_mw / 1000.0}] [expr {$sw_mw / 1000.0}] [expr {$tot_mw / 1000.0}]"
@file 69: close $fh
@file 70:
@file 71: set ppa_activity "VCD 0-inputs/outputs/pe.vcd, Voltus at tt"
@file 72: source $in_dir/ppa.tcl
@file 73: ppa_report $rpt_dir/final_qor.rpt $rpt_dir/final_power.rpt $rpt_dir/pe_ppa_final.rpt
@file 74: exit

