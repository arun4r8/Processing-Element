#@ Begin verbose source /misc/scratch/ar76269/pe-apprentice/2-floorplan/SetPinGroup.tcl (pre)
@file 1: # ââ Pin groups âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
@file 2: # Port names for each edit_pin in floorplan.tcl. Buses list bit 0 first.
@file 3:
@file 4: # bus pe_psum_in 16 -> pe_psum_in[0] pe_psum_in[1] ... pe_psum_in[15]
@file 5: proc bus {name width} {
    set pins {}
    for {set i 0} {$i < $width} {incr i} { lappend pins "$name\[$i\]" }
    return $pins
}
@file 10:
@file 11: # ââ Inputs âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
