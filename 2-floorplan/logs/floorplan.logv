[11/22 10:50:22     17s] @file 2: # Port names for each edit_pin in floorplan.tcl. Buses list bit 0 first.
[11/22 10:50:22     17s] @file 3:
[11/22 10:50:22     17s] @file 4: # bus pe_psum_in 16 -> pe_psum_in[0] pe_psum_in[1] ... pe_psum_in[15]
[11/22 10:50:22     17s] @file 5: proc bus {name width} {
[11/22 10:50:22     17s]     set pins {}
[11/22 10:50:22     17s]     for {set i 0} {$i < $width} {incr i} { lappend pins "$name\[$i\]" }
[11/22 10:50:22     17s]     return $pins
[11/22 10:50:22     17s] }
